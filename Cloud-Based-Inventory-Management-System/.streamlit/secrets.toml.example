# ==============================================================================
# Streamlit Community Cloud & Local Secrets Configuration Template
# ==============================================================================
# 
# LOCAL USAGE:
# 1. Copy this file to `.streamlit/secrets.toml`:
#    cp .streamlit/secrets.toml.example .streamlit/secrets.toml
# 2. Replace the placeholder values with your live DBaaS credentials.
# 3. Ensure `.streamlit/secrets.toml` is ignored by Git (enforced via .gitignore).
#
# STREAMLIT COMMUNITY CLOUD USAGE:
# 1. Go to https://share.streamlit.io and select your deployed app.
# 2. Click "Settings" (gear icon) -> "Secrets".
# 3. Copy and paste the TOML block below into the secrets text editor and save.
# ==============================================================================

# Standard MySQL DBaaS Connection Block
[mysql]
# Remote Database Host (e.g. "mysql-291a-myorg.aivencloud.com" or "roundhouse.proxy.rlwy.net")
host = "your-remote-mysql-host.region.provider.com"

# Port (Standard MySQL: 3306. Aiven / Railway often allocate high ports like 13452, 28190)
port = 3306

# Database Schema Name (e.g., "inventory_db" or Aiven's "defaultdb")
database = "inventory_db"

# Database Username (e.g., "avnadmin" for Aiven, "root" for Railway)
user = "admin_user"

# Password associated with the DB user
password = "your-secure-production-password"

# Connection Pooling Configuration (Optimized for Streamlit Cloud concurrency)
pool_size = 10
max_overflow = 20
pool_timeout = 30
pool_recycle = 3600

# SSL / TLS Settings for Managed DBaaS
# For Aiven: Set ssl_verify_cert = false or specify path to ca.pem
# For Railway / AWS RDS: ssl_verify_cert = false is sufficient for TLS encryption
ssl_verify_cert = false
ssl_ca = ""

# Optional: Streamlit 1.28+ Native SQL Connection compatibility block
[connections.mysql]
dialect = "mysql"
driver = "pymysql"
host = "your-remote-mysql-host.region.provider.com"
port = 3306
database = "inventory_db"
username = "admin_user"
password = "your-secure-production-password"
query = { charset = "utf8mb4" }
